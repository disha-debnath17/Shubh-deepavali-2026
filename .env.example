# API URL for the serverless Gemini greeting function (e.g. https://xyz.execute-api.us-east-1.amazonaws.com/prod/greeting)
VITE_API_URL=

# Note: GEMINI_API_KEY is only for the serverless folder (AWS Lambda environment variable), NEVER expose to browser/Vite
GEMINI_API_KEY=

# Allowed origin for CORS in the serverless function (e.g. https://main.d12345.amplifyapp.com or *)
ALLOWED_ORIGIN=
