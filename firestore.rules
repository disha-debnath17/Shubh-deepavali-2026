rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all collections and documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Validation for new community wish creation
    function isValidWishCreate(data) {
      return data.keys().hasAll(['id', 'wish', 'timestamp', 'userId', 'moderationStatus', 'reports'])
        && data.keys().hasOnly(['id', 'name', 'recipientName', 'state', 'wish', 'timestamp', 'userId', 'moderationStatus', 'reports', 'reportedBy', 'isSample', 'isVerified'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.userId == request.auth.uid
        && data.wish is string && data.wish.size() >= 3 && data.wish.size() <= 160
        && (!('name' in data) || (data.name is string && data.name.size() <= 50))
        && (!('recipientName' in data) || (data.recipientName is string && data.recipientName.size() <= 50))
        && (!('state' in data) || (data.state is string && data.state.size() <= 60))
        && data.timestamp is number
        && data.moderationStatus == 'pending'
        && data.reports == 0
        && (!('reportedBy' in data) || (data.reportedBy is list && data.reportedBy.size() == 0))
        && (!('isSample' in data) || data.isSample == false)
        && (!('isVerified' in data) || data.isVerified == false);
    }

    // Validation for user reporting a wish (anti-spam, cannot report repeatedly, reports increments by 1)
    function isValidWishReport(prev, next) {
      return isAuthenticated()
        && next.id == prev.id
        && next.userId == prev.userId
        && next.wish == prev.wish
        && next.timestamp == prev.timestamp
        && next.isSample == prev.isSample
        && next.isVerified == prev.isVerified
        && (!('reportedBy' in prev) || !prev.reportedBy.hasAny([request.auth.uid]))
        && next.reportedBy.hasAll(prev.get('reportedBy', []))
        && next.reportedBy.hasAny([request.auth.uid])
        && next.reportedBy.size() == prev.get('reportedBy', []).size() + 1
        && next.reports == prev.reports + 1
        && (next.reports >= 3 ? next.moderationStatus == 'flagged' : next.moderationStatus == prev.moderationStatus);
    }

    // Least-privilege rules for the wishes collection used by the community wall
    match /wishes/{wishId} {
      // Reading active unflagged wishes or author's own wish
      allow get: if resource.data.moderationStatus != 'flagged' || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if request.query.limit <= 50;

      // Authenticated users (including anonymous auth) can create their own wish
      allow create: if isAuthenticated()
        && request.resource.data.id == wishId
        && isValidWishCreate(request.resource.data);

      // Community reporting with strict validation
      allow update: if isAuthenticated() && isValidWishReport(resource.data, request.resource.data);

      // Authors can delete their own wish
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
